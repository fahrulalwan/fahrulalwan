# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills (vendor, re-installable)
.agents/skills/

# superpowers brainstorm sessions
.superpowers/

# direnv
.direnv/
.envrc

# Lighthouse CI output
.lighthouseci/

# ground-up rebuild marker (local; drives ~/.claude ground-up-gate hook)
.ground-up

# Agent worktrees. Untracked but not ignored, these were being read by two tools
# that scan the project directory rather than the git index: Tailwind's automatic
# content detection generated utilities from their stale copies of the source and
# shipped them in the CSS every visitor downloads, and `biome check .` aborted on
# the biome.json each one carries. Ignoring the directory fixes both and keeps the
# worktrees themselves, which is the point — they are deliberate, not debris.
.claude/worktrees/
